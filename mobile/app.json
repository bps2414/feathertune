{
  "expo": {
    "name": "feathertune remote",
    "slug": "feathertune-remote",
    "version": "0.2.0",
    "scheme": "feathertune-remote",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "dev.feathertune.remote",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "feathertune remote talks to your PC over your home network to show what it plays and to send play, pause, next and volume. It never leaves your network.",
        "NSCameraUsageDescription": "feathertune remote uses the camera only to scan the pairing code shown by feathertune on your PC. Nothing is recorded or saved.",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "dev.feathertune.remote",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#5b4bdb"
      },
      "permissions": ["android.permission.ACCESS_LOCAL_NETWORK", "android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#f3f4f8",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#171a22" }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "feathertune remote uses the camera only to scan the pairing code shown by feathertune on your PC. Nothing is recorded or saved.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ]
    ]
  }
}
