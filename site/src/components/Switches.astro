---
import { strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const s = strings[Astro.props.locale].switches;
---

<section class="wrap section switches" aria-labelledby="switches-title">
  <div class="head">
    <h2 id="switches-title">{s.title}</h2>
    <p class="lede">{s.lede}</p>
  </div>
  <ul class="list">
    {
      s.items.map((item) => (
        <li class:list={{ off: !item.on }}>
          <span class="toggle" aria-hidden="true" />
          <span class="name">{item.title}</span>
          {item.on ? <span class="sr-only">{s.on}</span> : <span class="tag">{s.experimental}</span>}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .head {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 60rem) {
    .head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: 3rem;
    }
  }

  .list {
    display: grid;
    gap: 0 3rem;
    margin: clamp(2rem, 1.5rem + 2vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 52rem) {
    .list {
      grid-template-columns: 1fr 1fr;
    }
  }

  li {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .toggle {
    position: relative;
    flex: none;
    width: 2.6rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--feather);
  }

  .toggle::after {
    content: '';
    position: absolute;
    top: 0.2rem;
    left: 1.3rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--on-feather);
  }

  .off .toggle {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--mist);
  }

  .off .toggle::after {
    left: 0.2rem;
    background: var(--mist);
  }

  .name {
    flex: 1;
    line-height: 1.35;
  }

  .tag {
    flex: none;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--paper-deep);
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 700;
  }
</style>
