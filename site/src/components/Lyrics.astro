---
import FeatherMark from './FeatherMark.astro';
import { records, strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const s = strings[Astro.props.locale].lyrics;
const song = records[0];
---

<section class="wrap section lyrics" aria-labelledby="lyrics-title">
  <div class="text">
    <h2 id="lyrics-title">{s.title}</h2>
    <p class="lede">{s.lede}</p>
    <dl class="features">
      {
        s.items.map((item) => (
          <div>
            <dt>{item.title}</dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <figure class="cards" aria-hidden="true">
    <div class="card card-alt"></div>
    <div class="card">
      <div class="card-art"></div>
      <p class="card-lines">
        {s.card.map((line) => <span>{line}</span>)}
      </p>
      <div class="card-foot">
        <p class="card-song">
          <span>{song.title}</span>
          <span>{song.artist}</span>
        </p>
        <FeatherMark size={22} />
      </div>
    </div>
  </figure>
</section>

<style>
  .lyrics {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
  }

  @media (min-width: 62rem) {
    .lyrics {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: center;
    }
  }

  .text {
    display: grid;
    gap: 1.25rem;
  }

  .features {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin: 1.5rem 0 0;
  }

  @media (min-width: 40rem) {
    .features {
      grid-template-columns: 1fr 1fr;
    }
  }

  .features div {
    padding-left: 1rem;
    border-left: 3px solid var(--glow);
  }

  dt {
    font-family: var(--display);
    font-size: var(--step-1);
    font-stretch: 108%;
    font-weight: 650;
    line-height: 1.2;
  }

  dd {
    margin: 0.4rem 0 0;
    color: var(--ink-soft);
    max-width: 34ch;
  }

  /* Two lyric cards like the share window makes, one per look: the cover bleeds into the lines. */
  .cards {
    position: relative;
    justify-self: center;
    display: grid;
    width: min(21rem, 100%);
    margin: 0;
  }

  .card {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    align-content: end;
    gap: 1.25rem;
    min-height: 27rem;
    padding: 1.5rem;
    overflow: hidden;
    border-radius: 1.1rem;
    background: #1d1530;
    color: #fff8ee;
    rotate: -3deg;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.07),
      0 2rem 4rem -1.5rem rgb(23 20 58 / 0.6);
  }

  /* The second look, tucked behind. */
  .card-alt {
    translate: 1.6rem 0.4rem;
    rotate: 5deg;
    background:
      repeating-linear-gradient(0deg, transparent 0 9%, rgb(143 211 199 / 0.35) 9% 11%),
      linear-gradient(160deg, #0f4c5c, #072a33 70%);
    opacity: 0.85;
  }

  .card-art {
    position: absolute;
    inset: 0 0 auto;
    aspect-ratio: 1;
    background:
      radial-gradient(circle at 68% 38%, #f2a65a 0 15%, rgb(242 166 90 / 0.25) 15.5% 24%, transparent 32%),
      linear-gradient(180deg, #3b2a5c 0 58%, #6d4c8f 58% 63%, #241a3a 63% 100%);
    mask-image: linear-gradient(180deg, #000 55%, transparent);
  }

  .card-lines {
    position: relative;
    display: grid;
    font-family: var(--display);
    font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.2rem);
    font-stretch: 116%;
    font-weight: 700;
    line-height: 1.02;
    text-wrap: balance;
    filter: drop-shadow(0 0 0.4em rgb(242 166 90 / 0.45));
  }

  .card-foot {
    position: relative;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 248 238 / 0.18);
  }

  .card-song {
    display: grid;
    font-size: 0.8rem;
    line-height: 1.3;
  }

  .card-song span:first-child {
    font-weight: 700;
  }

  .card-song span:last-child {
    opacity: 0.7;
  }
</style>
