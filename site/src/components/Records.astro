---
import { records, strings, type Locale } from '../i18n/strings';

interface Props {
  locale: Locale;
}

const s = strings[Astro.props.locale].records;
---

<section class="wrap section records" aria-labelledby="records-title">
  <div class="intro">
    <h2 id="records-title">{s.title}</h2>
    <p class="lede">{s.lede}</p>

    <fieldset class="picker">
      <legend>{s.pick}</legend>
      {
        records.map((r, i) => (
          <label class={`pick pick-${r.id}`}>
            <input type="radio" name="record" value={r.id} id={`rec-${r.id}`} checked={i === 0} />
            <span class="swatch" aria-hidden="true" />
            <span class="pick-text">
              <span class="pick-title">{r.title}</span>
              <span class="pick-artist">
                {s.by} {r.artist}
              </span>
            </span>
          </label>
        ))
      }
    </fieldset>
  </div>

  <div class="stage" aria-hidden="true" data-stage>
    <div class="win">
      <div class="bar">
        <span class="nav">
          <svg viewBox="0 0 16 16"><path d="M10 3 5 8l5 5"></path></svg>
          <svg viewBox="0 0 16 16"><path d="m6 3 5 5-5 5"></path></svg>
        </span>
        <span class="app">feathertune</span>
        <span class="playing">
          {
            records.map((r) => (
              <span data-rec={r.id}>
                <b>{r.title}</b> {r.artist}
              </span>
            ))
          }
        </span>
        <span class="tools">
          <svg viewBox="0 0 16 16"><path d="M8 10V2M5 5l3-3 3 3M3 8v5h10V8"></path></svg>
          <svg viewBox="0 0 16 16"><path d="M5 5h6a3 3 0 0 1 3 3v1a2 2 0 0 1-3.6 1.2L9.5 9h-3l-.9 1.2A2 2 0 0 1 2 9V8a3 3 0 0 1 3-3z"></path></svg>
          <svg viewBox="0 0 16 16"><path d="M2 3h12v10H2zM8 8h5v4H8z"></path></svg>
          <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="2.2"></circle><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"></path></svg>
        </span>
        <span class="caption">
          <svg viewBox="0 0 16 16"><path d="M4 8h8"></path></svg>
          <svg viewBox="0 0 16 16"><path d="M4.5 4.5h7v7h-7z"></path></svg>
          <svg viewBox="0 0 16 16"><path d="m4.5 4.5 7 7m0-7-7 7"></path></svg>
        </span>
      </div>

      <div class="page">
        {records.map((r) => <div class={`ambient amb-${r.id}`} data-rec={r.id} />)}
        <p class="tabs">
          {s.tabs.map((tab, i) => <span class={i === 1 ? 'on' : undefined}>{tab}</span>)}
        </p>
        <div class="view" data-view>
          {
            records.map((r) => (
              <ol class="lines" data-rec={r.id}>
                {r.lines.map((line) => (
                  <li>
                    {line.split(' ').map((word) => (
                      <span>{word} </span>
                    ))}
                  </li>
                ))}
              </ol>
            ))
          }
        </div>
      </div>

      <div class="player">
        <span class="controls">
          <svg viewBox="0 0 16 16"><path d="M4 3v10M13 3 6 8l7 5z"></path></svg>
          <svg viewBox="0 0 16 16" class="big"><path d="M4 2.5v11l9.5-5.5z"></path></svg>
          <svg viewBox="0 0 16 16"><path d="M12 3v10M3 3l7 5-7 5z"></path></svg>
        </span>
        <span class="time">1:12 / 3:41</span>
        <span class="player-track">
          {
            records.map((r) => (
              <span data-rec={r.id}>
                <b>{r.title}</b>
                {r.artist}
              </span>
            ))
          }
        </span>
        <span class="seek"><span data-seek></span></span>
      </div>
    </div>

    <figure class="mini">
      <div class="mini-body">
        {
          records.map((r) => (
            <div data-rec={r.id}>
              <p class="mini-title">{r.title}</p>
              <p class="mini-artist">{r.artist}</p>
            </div>
          ))
        }
        <p class="mini-line" data-mini-line>{records[0].lines[0]}</p>
        <p class="mini-controls">
          <svg viewBox="0 0 16 16"><path d="M4 3v10M13 3 6 8l7 5z"></path></svg>
          <svg viewBox="0 0 16 16"><path d="M4 2.5v11l9.5-5.5z"></path></svg>
          <svg viewBox="0 0 16 16"><path d="M12 3v10M3 3l7 5-7 5z"></path></svg>
        </p>
      </div>
      <figcaption>{s.mini}</figcaption>
    </figure>
  </div>
</section>

<script>
  // The Lyrics tab playing: words light up in turn and the lines glide up, like the app. ~2.5 steps a
  // second, only while it is on screen and the tab is visible; one still frame for reduced motion.
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const section = stage?.closest('section');
  if (stage && section) {
    const view = stage.querySelector<HTMLElement>('[data-view]')!;
    const seek = stage.querySelector<HTMLElement>('[data-seek]')!;
    const miniLine = stage.querySelector<HTMLElement>('[data-mini-line]')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let line = 0;
    let word = 0;
    let rest = 0;

    const lines = () => {
      const id = section.querySelector<HTMLInputElement>('input[name="record"]:checked')?.value ?? 'a';
      return [...view.querySelectorAll<HTMLElement>(`.lines[data-rec="${id}"] li`)];
    };

    const draw = () => {
      const all = lines();
      const current = all[line];
      if (!current) return;
      all.forEach((li, i) => {
        li.classList.toggle('on', i === line);
        li.dataset.d = String(Math.min(Math.abs(i - line), 3));
        [...li.children].forEach((w, j) => w.classList.toggle('sung', i < line || (i === line && j < word)));
      });
      current.parentElement!.style.transform = `translateY(${view.clientHeight * 0.32 - current.offsetTop}px)`;
      miniLine.textContent = current.textContent;
      const words = current.children.length;
      seek.style.width = `${((line + Math.min(word, words) / words) / all.length) * 100}%`;
    };

    const step = () => {
      const all = lines();
      const words = all[line]?.children.length ?? 0;
      if (word < words) word++;
      else if (++rest > 2) {
        rest = 0;
        word = 0;
        line = (line + 1) % all.length;
      }
      draw();
    };

    let timer = 0;
    let seen = false;
    const sync = () => {
      const run = seen && !document.hidden && !still.matches;
      if (run && !timer) timer = window.setInterval(step, 380);
      if (!run && timer) {
        clearInterval(timer);
        timer = 0;
      }
      if (still.matches) {
        line = 1;
        word = 99;
        draw();
      }
    };

    section.addEventListener('change', () => {
      line = 0;
      word = 0;
      rest = 0;
      draw();
      sync();
    });
    new IntersectionObserver(([entry]) => {
      seen = entry.isIntersecting;
      sync();
    }).observe(stage);
    document.addEventListener('visibilitychange', sync);
    still.addEventListener('change', sync);
    draw();
    sync();
  }
</script>

<style>
  /* Each record sets the colors the app would take from its cover. */
  .records {
    --bar: #3b2a5c;
    --bar-ink: #fbe9d7;
    --accent: #f2a65a;
    --deep: #1d1530;
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .records:has(#rec-b:checked) {
    --bar: #0f4c5c;
    --bar-ink: #dff5f0;
    --accent: #8fd3c7;
    --deep: #072a33;
  }

  .records:has(#rec-c:checked) {
    --bar: #6b2d2a;
    --bar-ink: #fff1d6;
    --accent: #f4c95d;
    --deep: #2e1311;
  }

  [data-rec] {
    display: none;
  }

  .records:has(#rec-a:checked) [data-rec='a'],
  .records:has(#rec-b:checked) [data-rec='b'],
  .records:has(#rec-c:checked) [data-rec='c'] {
    display: revert;
  }

  @media (min-width: 64rem) {
    .records {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
    }
  }

  .intro {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .picker {
    display: grid;
    gap: 0.25rem;
    margin: 1rem 0 0;
    padding: 0;
    border: 0;
  }

  legend {
    margin-bottom: 0.75rem;
    padding: 0;
    font-weight: 700;
  }

  /* A record is shown by the colors the app takes from its cover. */
  .pick-a {
    --s1: #3b2a5c;
    --s2: #f2a65a;
    --s3: #6d4c8f;
  }

  .pick-b {
    --s1: #0f4c5c;
    --s2: #8fd3c7;
    --s3: #072a33;
  }

  .pick-c {
    --s1: #6b2d2a;
    --s2: #f4c95d;
    --s3: #2e1311;
  }

  .pick {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    border-radius: 0.75rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .pick:hover,
  .pick:has(input:checked) {
    background: var(--paper-deep);
  }

  .pick:has(input:focus-visible) {
    outline: 3px solid var(--feather);
    outline-offset: 2px;
  }

  .pick input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .swatch {
    flex: none;
    width: 2.25rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(var(--s1) 0 40%, var(--s2) 40% 70%, var(--s3) 70% 100%);
    transition: box-shadow 0.2s ease;
  }

  .pick:has(input:checked) .swatch {
    box-shadow:
      0 0 0 3px var(--paper-deep),
      0 0 0 5px var(--s2);
  }

  .pick-text {
    display: grid;
    line-height: 1.3;
  }

  .pick-title {
    font-weight: 700;
  }

  .pick-artist {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* The window, as the app shows the site's Lyrics tab: the title bar in the record's colors, ambient
     mode behind the page, the synced lyrics and the site's player bar. */
  .stage {
    position: relative;
    padding-bottom: clamp(3rem, 2rem + 6vw, 6rem);
  }

  .win {
    overflow: hidden;
    border-radius: 0.6rem;
    background: var(--deep);
    color: #fff;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 2.5rem 5rem -2rem rgb(23 20 58 / 0.55);
    transition: background-color 0.5s ease;
  }

  svg {
    display: block;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 2.1rem;
    padding-left: 0.6rem;
    background: var(--bar);
    color: var(--bar-ink);
    font-size: 0.75rem;
    white-space: nowrap;
    transition: background-color 0.5s ease, color 0.5s ease;
  }

  .nav {
    display: flex;
    gap: 0.35rem;
    opacity: 0.55;
  }

  .app {
    font-weight: 700;
  }

  .playing {
    flex: 1;
    overflow: hidden;
    min-width: 0;
    text-align: center;
    text-overflow: ellipsis;
  }

  .playing span {
    color: color-mix(in srgb, var(--bar-ink) 65%, transparent);
  }

  .playing b {
    margin-right: 0.35rem;
    color: var(--bar-ink);
  }

  .tools {
    display: flex;
    gap: 0.85rem;
    opacity: 0.8;
  }

  .tools svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .caption {
    display: flex;
  }

  .caption svg {
    box-sizing: content-box;
    width: 0.75rem;
    height: 0.75rem;
    padding: 0.67rem 0.95rem;
    stroke-width: 1.1;
  }

  .page {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr;
    height: clamp(17rem, 12rem + 16vw, 24rem);
    padding: 0.9rem clamp(1.25rem, 0.5rem + 3vw, 3rem) 0;
    overflow: hidden;
  }

  .ambient {
    position: absolute;
    inset: -15%;
    z-index: -1;
    filter: blur(40px);
    opacity: 0.6;
  }

  .amb-a {
    background:
      radial-gradient(circle at 78% 28%, #f2a65a, transparent 38%),
      radial-gradient(circle at 18% 85%, #6d4c8f, transparent 50%);
  }

  .amb-b {
    background:
      radial-gradient(circle at 75% 25%, #8fd3c7, transparent 36%),
      radial-gradient(circle at 20% 80%, #0f4c5c, transparent 55%);
  }

  .amb-c {
    background:
      radial-gradient(circle at 76% 30%, #f4c95d, transparent 36%),
      radial-gradient(circle at 15% 80%, #a3473f, transparent 50%);
  }

  .tabs {
    display: flex;
    gap: 1.75rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .tabs span {
    padding-bottom: 0.55rem;
    opacity: 0.55;
  }

  .tabs .on {
    border-bottom: 2px solid #fff;
    opacity: 1;
  }

  .view {
    position: relative;
    overflow: hidden;
    mask-image: linear-gradient(180deg, transparent, #000 18%, #000 70%, transparent);
  }

  /* The lines, styled like the app's synced lyrics: they fade with their distance from the one being
     sung, which is full size and glows in the record's accent, word by word. */
  .lines {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .lines li {
    padding: 0.4rem 0;
    font-size: clamp(1.15rem, 0.85rem + 1.1vw, 1.75rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    opacity: 0.28;
    transform: scale(0.94);
    transform-origin: left center;
    transition:
      opacity 0.9s ease,
      transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .lines li[data-d='2'] {
    opacity: 0.36;
  }

  .lines li[data-d='1'] {
    opacity: 0.5;
  }

  .lines li.on {
    color: rgb(255 255 255 / 0.5);
    opacity: 1;
    transform: scale(1);
  }

  .lines li.on .sung {
    color: #fff;
    text-shadow: 0 0 0.7em color-mix(in srgb, var(--accent) 70%, transparent);
    transition: color 0.25s ease;
  }

  .player {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.25rem;
    padding: 0 1rem;
    background: rgb(0 0 0 / 0.35);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .controls svg,
  .mini-controls svg {
    fill: currentColor;
    width: 0.85rem;
    height: 0.85rem;
  }

  .controls .big {
    width: 1.3rem;
    height: 1.3rem;
  }

  .time {
    opacity: 0.6;
  }

  .player-track {
    overflow: hidden;
    min-width: 0;
    text-overflow: ellipsis;
  }

  .player-track span {
    color: rgb(255 255 255 / 0.65);
  }

  .player-track b {
    margin-right: 0.4rem;
    color: #fff;
  }

  .seek {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
    background: rgb(255 255 255 / 0.15);
  }

  .seek span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--accent);
    transition: width 0.38s linear, background-color 0.5s ease;
  }

  /* The mini player overlaps the window's corner, as it floats over everything. */
  .mini {
    position: absolute;
    right: clamp(0.5rem, -1rem + 4vw, 2rem);
    bottom: 0;
    width: min(17rem, 78%);
    margin: 0;
    padding: 0.8rem 0.9rem;
    border-radius: 0.75rem;
    background: var(--bar);
    color: var(--bar-ink);
    box-shadow: 0 1.5rem 3rem -1rem rgb(23 20 58 / 0.6);
    transition: background-color 0.5s ease, color 0.5s ease;
  }

  .mini-body {
    min-width: 0;
    font-size: 0.8rem;
    line-height: 1.3;
  }

  .mini-title {
    overflow: hidden;
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mini-artist {
    opacity: 0.75;
  }

  .mini-line {
    margin-top: 0.4rem;
    overflow: hidden;
    color: var(--accent);
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mini-controls {
    display: flex;
    gap: 0.9rem;
    margin-top: 0.45rem;
  }

  .mini figcaption {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  @media (max-width: 34rem) {
    .tools,
    .nav,
    .time,
    .player-track {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .win,
    .bar,
    .mini,
    .pick,
    .swatch,
    .lines,
    .lines li,
    .seek span {
      transition: none;
    }
  }
</style>
