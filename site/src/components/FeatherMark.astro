---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<!-- A feather drawn as a waveform: the bars follow a feather's outline along a quill. -->
<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="18" fill="#5A4BDA"></rect>
  <g transform="rotate(-42 32 32)" stroke-linecap="round" fill="none">
    <path d="M7 38H20" stroke="#fff" stroke-width="3.2"></path>
    <path d="M22 33v8M29 28v11M36 24v13M43 25v11M50 30v6" stroke="#fff" stroke-width="4.6"></path>
    <path d="M57 33h0" stroke="#FFC56B" stroke-width="4.6"></path>
  </g>
</svg>
