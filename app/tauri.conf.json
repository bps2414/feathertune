{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "feathertune",
  "version": "0.2.1",
  "identifier": "dev.feathertune.desktop",
  "app": {
    "windows": [],
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Lightweight desktop shell for a web music player",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "English",
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
